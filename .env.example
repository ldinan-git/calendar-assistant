# Which model answers. You can also switch in the app header (that choice is remembered in the browser).
#   ollama     a local model through http://localhost:11434 (default; no key). Pull one first: ollama pull llama3.2
#   anthropic  the Anthropic API straight from the browser. Demo only, the key is exposed to the client.
#   mock       no model: canned teaching responses + rule-based stand-ins
VITE_LLM_MODE=ollama
VITE_MOCK_DELAY_MS=400

# ollama
VITE_OLLAMA_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=llama3.2:latest

# anthropic
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-sonnet-5-5

# Rate every calendar event with the model too (default: rules plus taught facts, because a small CPU model is too slow for it)
# VITE_LLM_ANALYZE=1
